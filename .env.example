# Server Environment Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/zsyiogpt

# Authentication Security
JWT_SECRET=super_secret_jwt_development_key_change_in_production_987654321
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production_123456789
JWT_REFRESH_EXPIRES_IN=30d

# AI Provider API Keys (Stored securely only on the server)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
XAI_API_KEY=

# Redis (Optional cache/rate-limiting)
REDIS_URL=

# Storage (S3 / Local fallback)
STORAGE_TYPE=local
STORAGE_DIR=./uploads
